<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Legacy Web Forms configuration.

  NO SECRETS IN THIS FILE. It holds only the API base address and framework
  settings. That is itself part of the modernization: this application no longer
  has a database connection string, because it no longer talks to a database —
  the modern API owns all persistence.

  If a credential were ever needed here, it would go in an external file
  referenced by configSource and excluded from source control, or in an
  encrypted configuration section (aspnet_regiis -pe).
  ============================================================================
-->
<configuration>

  <appSettings>
    <!--
      Where the modern PolicyFlow API lives. This single setting is the entire
      seam configuration: pointing it at a different environment needs no
      rebuild.

      Local Docker default. The API container publishes 8081 on the host.
    -->
    <add key="PolicyFlow.ApiBaseAddress" value="http://localhost:8081" />

    <!--
      15 seconds. Quote submission returns 202 immediately and status is a single
      indexed read, so nothing here should ever be slow. A short timeout surfaces
      a hung API as a clear error instead of an IIS worker thread parked for two
      minutes.
    -->
    <add key="PolicyFlow.ApiTimeoutMs" value="15000" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8"
                 enableVersionHeader="false"
                 maxRequestLength="4096" />

    <!--
      ViewState MAC validation. Non-negotiable: without it ViewState can be
      tampered with by the client, and ViewState drives control state and event
      routing. AES/HMACSHA256 rather than the older defaults.

      validationKey and decryptionKey are deliberately AutoGenerate. Hard-coded
      keys in a committed Web.config are a classic finding — they let anyone with
      repository access forge ViewState. A real web farm needs fixed keys so all
      nodes agree, and those belong in a machine-level configuration or a secret
      store, never here.
    -->
    <machineKey validation="HMACSHA256"
                decryption="AES"
                validationKey="AutoGenerate,IsolateApps"
                decryptionKey="AutoGenerate,IsolateApps" />

    <!--
      No <namespaces> block. The Web Forms project template adds
      <add namespace="System.Web.Optimization" /> here, but that type lives in
      the Microsoft.AspNet.Web.Optimization NuGet package, which this project
      does not reference and does not need — there is no bundling or
      minification. Leaving the template's entry in place makes aspnet_compiler
      fail with CS0234 at precompile time while `msbuild` on the project alone
      still succeeds, so it is the kind of defect that only surfaces at deploy.

      This project having zero NuGet dependencies is a consequence of the
      modernization: with the business logic moved to the API, there is nothing
      left for it to depend on.
    -->
    <pages enableViewState="true"
           enableViewStateMac="true"
           viewStateEncryptionMode="Always"
           validateRequest="true"
           controlRenderingCompatibilityVersion="4.8" />

    <!--
      Custom errors ON with RemoteOnly. The ASP.NET yellow screen of death
      includes the stack trace, the source file path and often a source excerpt —
      a detailed map of the application for anyone who can trigger an exception.
      Developers on the local machine still see it; remote users never do.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Default.aspx">
      <error statusCode="404" redirect="~/Default.aspx" />
      <error statusCode="500" redirect="~/Default.aspx" />
    </customErrors>

    <!-- Session is not used: this application holds no server-side state. -->
    <sessionState mode="Off" />

    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />

    <authentication mode="None" />
  </system.web>

  <system.webServer>
    <!--
      Response headers. Set here rather than in code because they must apply to
      every response including static files and error pages, which never reach
      managed code.
    -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove the headers that advertise the stack version. Free
             reconnaissance for an attacker otherwise. -->
        <remove name="X-Powered-By" />
        <remove name="Server" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- 4MB. This application accepts a small form and nothing else; a
             generous limit is just an easier denial-of-service target. -->
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

    <modules runAllManagedModulesForAllRequests="false" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Web Forms applications of this age invariably accumulate binding
           redirects. Left empty here because this project has no NuGet
           dependencies at all, which is itself a consequence of moving the logic
           out: there is nothing left for it to depend on. -->
    </assemblyBinding>
  </runtime>

</configuration>
