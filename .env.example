# ============================================================================
# PolicyFlow POC - local development environment template
# ----------------------------------------------------------------------------
# Copy to .env and replace every <placeholder>. NEVER commit .env.
#   cp .env.example .env
# All values below are LOCAL DEVELOPMENT ONLY placeholders.
# ============================================================================

# --- SQL Server 2022 (relational / transactional store, EF Core) ------------
# Must satisfy SQL Server complexity: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=<strong-local-sa-password>
SQL_DB_NAME=PolicyFlow
SQL_CONNECTION_STRING=Server=sql,1433;Database=PolicyFlow;User Id=sa;Password=<strong-local-sa-password>;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True

# --- MongoDB (NoSQL carrier catalog + quote comparison read models, EF Core)-
MONGO_INITDB_ROOT_USERNAME=policyflow_app
MONGO_INITDB_ROOT_PASSWORD=<strong-local-mongo-password>
MONGO_CONNECTION_STRING=mongodb://policyflow_app:<strong-local-mongo-password>@mongo:27017/?authSource=admin
MONGO_DATABASE=policyflow_catalog

# --- Azure Service Bus emulator --------------------------------------------
# The emulator's well-known local development key. Not a real Azure secret.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<local-emulator-key>;UseDevelopmentEmulator=true;
SERVICEBUS_NAMESPACE=sbemulatorns
SERVICEBUS_QUEUE=quote-submitted
SERVICEBUS_MAX_DELIVERY_COUNT=5

# --- Simulated identity provider (stands in for Microsoft Entra ID) --------
# HS256 signing key for the local dev token issuer. 32+ bytes.
# Production: replace with Entra ID authority + audience and delete the key.
JWT_ISSUER=https://policyflow-local-idp
JWT_AUDIENCE=policyflow-api
JWT_SIGNING_KEY=<local-dev-signing-key-min-32-chars>
JWT_TOKEN_LIFETIME_MINUTES=60
# Set to true ONLY for local demos. Exposes POST /api/auth/dev-token.
ENABLE_DEV_TOKEN_ENDPOINT=true

# --- API / Worker runtime --------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8081
API_BASE_URL=http://localhost:8081
# 44390 / 8095: legacy portal under IIS Express from Visual Studio / the command
# line (Underwriting.aspx calls the API directly).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://localhost:44390,http://localhost:8095
APPLY_MIGRATIONS_ON_STARTUP=true
SEED_CARRIER_CATALOG=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PERMIT_PER_MINUTE=120
RATE_LIMIT_QUEUE_LIMIT=10

# --- Web (React SPA) -------------------------------------------------------
WEB_HTTP_PORT=8080
VITE_API_BASE_URL=/api
